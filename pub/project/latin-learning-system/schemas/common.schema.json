{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"common.schema.json",
  "title":"Latin Learning System common definitions",
  "type":"object",
  "definitions":{
    "stableId":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$","minLength":3,"maxLength":120},
    "recordId":{"type":"string","pattern":"^(?:lex|ex|q|lesson|src|review|unit|skill|norm)-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skillId":{"type":"string","pattern":"^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"},
    "unitId":{"type":"string","pattern":"^unit-[0-9]{2}[a-z]?$"},
    "bibliographyId":{"type":"string","pattern":"^src-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "lexemeId":{"type":"string","pattern":"^lex-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "exampleId":{"type":"string","pattern":"^ex-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "exerciseId":{"type":"string","pattern":"^q-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "reviewId":{"type":"string","pattern":"^review-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "semver":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "isoDateTime":{"type":"string","format":"date-time"},
    "nonEmptyString":{"type":"string","minLength":1},
    "stringArray":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "skillArray":{"type":"array","items":{"$ref":"#/definitions/skillId"},"uniqueItems":true},
    "lexemeArray":{"type":"array","items":{"$ref":"#/definitions/lexemeId"},"uniqueItems":true},
    "evidenceRecord":{
      "type":"object","additionalProperties":false,
      "required":["kind","claim_scope","note"],
      "properties":{
        "kind":{"enum":["source-summary","source-quotation","source-paraphrase","source-adaptation","generated-rationale","project-decision","automated-result"]},
        "claim_scope":{"type":"string","minLength":1},
        "note":{"type":"string","minLength":1},
        "decision_id":{"type":"string","pattern":"^DEC-[0-9]{4}$"},
        "validation_id":{"type":"string","minLength":1}
      }
    },
    "evidenceArray":{"type":"array","items":{"$ref":"#/definitions/evidenceRecord"}},
    "m2ReviewFlags":{
      "type":"object","additionalProperties":false,
      "required":["source_checked","editorial_approved","expert_reviewed"],
      "properties":{"source_checked":{"type":"boolean"},"editorial_approved":{"type":"boolean"},"expert_reviewed":{"type":"boolean"}}
    },
    "baseMetadata":{
      "type":"object",
      "required":["id","schema_version","content_version","title","created_at","updated_at"],
      "properties":{
        "id":{"$ref":"#/definitions/recordId"},
        "schema_version":{"$ref":"#/definitions/semver"},
        "content_version":{"$ref":"#/definitions/semver"},
        "title":{"$ref":"#/definitions/nonEmptyString"},
        "created_at":{"$ref":"#/definitions/isoDateTime"},
        "updated_at":{"$ref":"#/definitions/isoDateTime"},
        "notes":{"type":"string"}
      }
    }
  }
}
