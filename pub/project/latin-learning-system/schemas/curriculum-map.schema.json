{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "curriculum-map.schema.json",
  "title": "M2 curriculum map",
  "type": "object", "additionalProperties": false,
  "required": ["schema_status", "version", "updated_on", "scope", "provisional_limits", "lexical_policy", "m3_handover", "units", "subunits", "review_schedule"],
  "properties": {
    "schema_status": {"const": "provisional-m2-json-compatible-yaml"}, "version": {"$ref": "common.schema.json#/definitions/semver"}, "updated_on": {"type": "string", "format": "date"}, "scope": {"type": "string", "minLength": 1},
    "provisional_limits": {"type": "object", "minProperties": 1}, "lexical_policy": {"type": "object", "minProperties": 1}, "m3_handover": {"type": "array", "items": {"type": "string"}}, "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/unit"}}, "subunits": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/subunit"}}, "review_schedule": {"type": "array", "items": {"$ref": "#/definitions/reviewSchedule"}}
  },
  "definitions": {
    "unit": {"type": "object", "additionalProperties": true, "required": ["unit_id", "title", "purpose", "prerequisites", "new_skills", "review_skills", "subunit_ids", "exit_criteria", "next_units", "evidence_refs", "review"], "properties": {"unit_id": {"$ref": "common.schema.json#/definitions/unitId"}, "title": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "prerequisites": {"$ref": "common.schema.json#/definitions/skillArray"}, "new_skills": {"$ref": "common.schema.json#/definitions/skillArray"}, "review_skills": {"$ref": "common.schema.json#/definitions/skillArray"}, "subunit_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/definitions/unitId"}}, "exit_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "next_units": {"type": "array", "items": {"$ref": "common.schema.json#/definitions/unitId"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "review": {"$ref": "common.schema.json#/definitions/m2ReviewFlags"}}},
    "subunit": {
      "type": "object", "additionalProperties": true,
      "required": ["unit_id", "parent_unit", "title", "purpose", "prerequisites", "new_skills", "review_skills", "skill_treatments", "lexical_requirements", "provisional_new_lexeme_limit", "provisional_new_skill_limit", "sentence_complexity_limit", "required_exercise_types", "cumulative_reading_spec", "exit_criteria", "next_units", "evidence_refs", "review"],
      "properties": {
        "unit_id": {"$ref": "common.schema.json#/definitions/unitId"}, "parent_unit": {"$ref": "common.schema.json#/definitions/unitId"}, "title": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "prerequisites": {"$ref": "common.schema.json#/definitions/skillArray"}, "new_skills": {"$ref": "common.schema.json#/definitions/skillArray"}, "review_skills": {"$ref": "common.schema.json#/definitions/skillArray"},
        "skill_treatments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill_ids", "learning_phases"],
            "properties": {
              "skill_ids": {"enum": ["new_skills", "review_skills"]},
              "learning_phases": {"type": "array", "items": {"enum": ["introduce", "guided-practice", "independent-practice", "cumulative-use", "review", "assess"]}}
            }
          }
        },
        "lexical_requirements": {"type": "object", "required": ["categories", "candidate_lemmas", "formal_vocabulary"]}, "provisional_new_lexeme_limit": {"type": "integer", "minimum": 0}, "provisional_new_skill_limit": {"type": "integer", "minimum": 0}, "sentence_complexity_limit": {"type": "object", "minProperties": 1}, "required_exercise_types": {"type": "array", "items": {"type": "string"}}, "cumulative_reading_spec": {"type": "object"}, "exit_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "next_units": {"type": "array", "items": {"$ref": "common.schema.json#/definitions/unitId"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "review": {"$ref": "common.schema.json#/definitions/m2ReviewFlags"}
      }
    },
    "reviewSchedule": {"type": "object", "additionalProperties": false, "required": ["cohort", "skill_ids", "introduced_at", "guided_at", "next_reuse", "spaced_review", "cumulative_use", "exit_assessment"], "properties": {"cohort": {"$ref": "common.schema.json#/definitions/unitId"}, "skill_ids": {"$ref": "common.schema.json#/definitions/skillArray"}, "introduced_at": {"$ref": "common.schema.json#/definitions/unitId"}, "guided_at": {"$ref": "common.schema.json#/definitions/unitId"}, "next_reuse": {"type": ["string", "null"], "pattern": "^unit-[0-9]{2}[a-z]?$"}, "spaced_review": {"type": ["string", "null"], "pattern": "^unit-[0-9]{2}[a-z]?$"}, "cumulative_use": {"type": ["string", "null"], "pattern": "^unit-[0-9]{2}[a-z]?$"}, "exit_assessment": {"type": ["string", "null"], "pattern": "^unit-[0-9]{2}[a-z]?$"}, "defer_reason": {"type": "string"}}}
  }
}
