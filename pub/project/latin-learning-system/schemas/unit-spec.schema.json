  "definitions":{"subunitSpec":{"type":"object","additionalProperties":false,"required":["subunit_id","title","observable_objectives","prerequisite_skills","new_skills","review_skills","lexical_conditions","allowed_sentence_structures","forbidden_or_unlearned_structures","planned_explanation_topics","planned_practice_formats","cumulative_reading_contribution","exit_criteria","human_review_required","evidence_refs","provisional_approval"],"properties":{"subunit_id":{"$ref":"common.schema.json#/definitions/unitId"},"title":{"type":"string","minLength":1},"observable_objectives":{"type":"array","minItems":1,"items":{"type":"string"}},"prerequisite_skills":{"$ref":"common.schema.json#/definitions/skillArray"},"new_skills":{"$ref":"common.schema.json#/definitions/skillArray"},"review_skills":{"$ref":"common.schema.json#/definitions/skillArray"},"lexical_conditions":{"type":"object","required":["categories","candidate_lemmas","limit","status"]},"allowed_sentence_structures":{"type":"array","items":{"type":"string"}},"forbidden_or_unlearned_structures":{"type":"array","items":{"type":"string"}},"planned_explanation_topics":{"type":"array","items":{"type":"string"}},"planned_practice_formats":{"type":"array","items":{"type":"string"}},"cumulative_reading_contribution":{"type":"string","minLength":1},"exit_criteria":{"type":"array","minItems":1,"items":{"type":"string"}},"human_review_required":{"type":"array","minItems":1,"items":{"type":"string"}},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"provisional_approval":{"type":"object","additionalProperties":false,"required":["draft","source_checked","editorial_approved","expert_reviewed"],"properties":{"draft":{"type":"boolean"},"source_checked":{"type":"boolean"},"editorial_approved":{"type":"boolean"},"expert_reviewed":{"type":"boolean"}}}}}
